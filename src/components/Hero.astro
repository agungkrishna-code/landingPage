---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { hero } from '../data/site';
---

<section class="hero" id="home" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-copy" data-hero-copy>
      <p class="hero-kicker" data-hero-kicker>
        <span class="kicker-mark" aria-hidden="true"></span>
        {hero.kicker}
      </p>

      <h1 class="hero-title" data-hero-title>
        {hero.titleLead} <em>{hero.titleAccent}</em>
      </h1>

      <p class="hero-sub" lang="id" data-hero-sub>{hero.sub}</p>

      <div class="hero-actions" data-hero-actions>
        <a class="btn btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="text-link" href={hero.secondary.href}>
          {hero.secondary.label}
          <span aria-hidden="true" class="link-arrow">&#8595;</span>
        </a>
      </div>
    </div>

    <figure class="portrait-plate" data-hero-portrait>
      <div class="portrait-frame">
        <span class="plate-label" aria-hidden="true">Portrait / 2026</span>
        <div class="portrait-inner" data-portrait-inner>
          <Picture
            src={portrait}
            alt={hero.portrait.alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[240, 320, 400, 464]}
            sizes="(max-width: 767px) 78vw, (max-width: 1023px) 42vw, 400px"
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
        </div>
        <span class="stamp portrait-stamp">Open to work</span>
      </div>
      <figcaption lang="id">{hero.portrait.caption}</figcaption>
    </figure>
  </div>

  <div class="wrap hero-rail" data-hero-rail>
    {hero.rail.map((item) => <span>{item}</span>)}
    <span class="scroll-cue" aria-hidden="true">
      Scroll
      <span class="cue-line"></span>
    </span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 72px);
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(36px, 6vw, 78px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(48px, 7vw, 76px);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-pine);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .kicker-mark {
    display: block;
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--color-copper);
    transform: rotate(45deg);
  }

  .hero-title {
    max-width: 11.5ch;
    margin-top: 18px;
    font-size: clamp(2.9rem, 6.15vw, 5.9rem);
    line-height: 1.01;
    letter-spacing: -0.035em;
  }

  .hero-title em {
    color: var(--color-pine);
    font-style: italic;
  }

  .hero-sub {
    max-width: 46ch;
    margin-top: clamp(22px, 3vw, 30px);
    color: var(--color-muted);
    font-size: clamp(1rem, 1.2vw, 1.0625rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-top: clamp(26px, 3.5vw, 36px);
  }

  .link-arrow {
    color: var(--color-copper);
    font-size: 0.85em;
  }

  .portrait-plate {
    width: min(100%, 420px);
    justify-self: start;
    margin: 0;
  }

  .portrait-frame {
    position: relative;
    padding: 9px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-chalk);
  }

  .portrait-frame::before,
  .portrait-frame::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: var(--color-copper);
    border-style: solid;
    pointer-events: none;
  }

  .portrait-frame::before {
    top: -4px;
    left: -4px;
    border-width: 1px 0 0 1px;
  }

  .portrait-frame::after {
    right: -4px;
    bottom: -4px;
    border-width: 0 1px 1px 0;
  }

  .plate-label {
    position: absolute;
    top: 18px;
    left: 20px;
    z-index: 1;
    color: var(--color-muted);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .portrait-inner {
    overflow: hidden;
    background: #e8deca;
    aspect-ratio: 10 / 11;
  }

  .portrait-inner picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .portrait-stamp {
    position: absolute;
    bottom: 22px;
    left: -12px;
    color: var(--color-pine);
    background: var(--color-chalk);
    transform: rotate(-3.5deg);
  }

  .portrait-plate figcaption {
    max-width: 36ch;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--color-line);
    border-image: var(--grad-rule) 1;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .hero-rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
    padding-block: 16px 20px;
    border-top: 1px solid var(--color-line-strong);
    border-image: var(--grad-rule-strong) 1;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .scroll-cue {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    color: var(--color-muted);
  }

  .cue-line {
    position: relative;
    display: block;
    width: 34px;
    height: 1px;
    overflow: hidden;
    background: var(--color-line);
  }

  .cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-copper);
    transform: translateX(-100%);
    animation: cue 2.6s var(--ease-ledger) infinite;
  }

  @keyframes cue {
    0%,
    10% {
      transform: translateX(-100%);
    }
    55%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
      align-items: end;
    }

    .portrait-plate {
      justify-self: end;
    }

    .hero-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    }

    .scroll-cue {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
      align-items: end;
    }

    .hero-copy {
      grid-column: 1 / span 7;
      padding-right: clamp(24px, 4vw, 64px);
    }

    .portrait-plate {
      grid-column: 8 / span 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue-line::after {
      animation: none;
      transform: translateX(0);
    }
  }
</style>