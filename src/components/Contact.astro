---
import { contact, site } from '../data/site';
const email = site.email;
---

<section class="contact" id="contact">
  <div class="wrap contact-inner">
    <div class="contact-rule" data-rule-draw></div>

    <div class="contact-grid">
      <div class="contact-main" data-reveal-group>
        <p class="section-label contact-label" data-reveal-child>{contact.label}</p>

        <h2 class="contact-title" data-reveal-child>
          {contact.titleLead} <em>{contact.titleAccent}</em> {contact.titleTail}
        </h2>

        <p class="contact-lead" lang="id" data-reveal-child>{contact.lead}</p>

        <a
          class="contact-email"
          href={`mailto:${email}?subject=Hello%20Krishna`}
          data-copy-source
          data-reveal-child
        >
          {email}
        </a>

        <div class="contact-actions" data-reveal-child>
          <button
            class="btn btn-outline-light btn-sm"
            type="button"
            data-copy-email
            data-email={email}
            data-copied-label={contact.copiedLabel}
            data-error-label={contact.copyErrorLabel}
          >
            <span data-copy-label>{contact.copyLabel}</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="11" height="11" rx="1"></rect>
              <path d="M5 15V5a1 1 0 0 1 1-1h10"></path>
            </svg>
          </button>
          <span class="copy-status" data-copy-status role="status" aria-live="polite"></span>
        </div>
      </div>

      <div class="contact-side" data-reveal>
        <p class="section-label contact-side-label">{contact.elsewhere}</p>

        <ul class="contact-links">
          {site.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer">
                <span class="social-label">{social.label}</span>
                <span class="social-handle">{social.handle}</span>
                <svg
                  class="social-arrow"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17L17 7M8 7h9v9"></path>
                </svg>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="contact-stamp">
          <span class="stamp stamp-on-dark">Open to work</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    --grad-accent: linear-gradient(
      100deg,
      var(--color-mint) 0%,
      color-mix(in srgb, var(--color-mint) 50%, var(--color-on-dark)) 100%
    );
    position: relative;
    overflow: hidden;
    background: var(--color-pine-deep);
    color: var(--color-on-dark);
  }

  .contact :focus-visible {
    outline-color: var(--color-mint);
  }

  .contact-inner {
    padding-block: clamp(64px, 9vw, 112px) clamp(56px, 8vw, 92px);
  }

  .contact-rule {
    height: 1px;
    margin-bottom: clamp(36px, 6vw, 64px);
    background: var(--grad-rule-on-dark);
    transform-origin: left center;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
  }

  .contact-label,
  .contact-side-label {
    color: var(--color-mint);
  }

  .contact-title {
    max-width: 13ch;
    margin-top: 16px;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 0.99;
    letter-spacing: -0.035em;
  }

  .contact-lead {
    max-width: 50ch;
    margin-top: 22px;
    color: var(--color-on-dark-soft);
    font-size: clamp(0.9875rem, 1.2vw, 1.0625rem);
    line-height: 1.7;
  }

  .contact-email {
    display: inline-flex;
    max-width: 100%;
    min-height: 44px;
    align-items: center;
    margin-top: clamp(28px, 4vw, 40px);
    color: var(--color-mint);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 2.05rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 0.2s var(--ease-ledger);
  }

  .contact-email:hover {
    color: var(--color-on-dark);
  }

  .contact-actions {
    display: flex;
    min-height: 44px;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 22px;
  }

  .copy-status {
    min-height: 1.2em;
    color: var(--color-mint);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .contact-side {
    padding-top: 14px;
    border-top: 1px solid var(--color-on-dark-line);
    border-image: var(--grad-rule-on-dark) 1;
  }

  .contact-side .contact-side-label {
    margin-bottom: 4px;
  }

  .contact-links {
    list-style: none;
  }

  .contact-links li {
    border-bottom: 1px solid var(--color-on-dark-line);
    border-image: var(--grad-rule-on-dark) 1;
  }

  .contact-links a {
    display: flex;
    min-height: 56px;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .social-label {
    width: 74px;
    flex: none;
    color: var(--color-on-dark-soft);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .social-handle {
    flex: 1;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.3;
    transition: color 0.2s var(--ease-ledger);
  }

  .social-arrow {
    flex: none;
    color: var(--color-mint);
    transition: transform 0.2s var(--ease-ledger);
  }

  .contact-links a:hover .social-handle {
    color: var(--color-mint);
  }

  .contact-links a:hover .social-arrow {
    transform: translate(2px, -2px);
  }

  .contact-stamp {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .contact-stamp .stamp {
    color: var(--color-mint);
    transform: rotate(-3deg);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(260px, 0.75fr);
      gap: clamp(48px, 7vw, 96px);
    }

    .contact-side {
      padding-top: 18px;
    }
  }

  @media (min-width: 1024px) {
    .contact-side {
      padding-top: 0;
      padding-left: clamp(28px, 4vw, 52px);
      border-top: 0;
      border-left: 1px solid var(--color-on-dark-line);
      border-image: var(--grad-rule-on-dark-y) 1;
    }

    .contact-side .contact-side-label {
      padding-top: 14px;
      border-top: 1px solid var(--color-on-dark-line);
      border-image: var(--grad-rule-on-dark) 1;
    }
  }
</style>