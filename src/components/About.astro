---
import { about, site } from '../data/site';
---

<section class="section about" id="about" data-about>
  <div class="wrap">
    <div class="about-head">
      <div class="about-heading" data-reveal-group>
        <p class="section-label" data-reveal-child>{about.label}</p>
        <h2 class="section-title" data-reveal-child>
          {about.titleLead} <em>{about.titleAccent}</em> {about.titleTail}
        </h2>
      </div>
      <p class="about-lead" lang="id" data-reveal>{about.lead}</p>
    </div>

    <div class="about-grid">
      <div class="about-body">
        <p lang="id" data-reveal>{about.body}</p>

        <div class="about-actions" data-reveal>
          <a
            class="btn btn-ghost btn-sm"
            href={site.cv}
            download={site.cvFilename}
          >
            {about.cvLabel}
            <span class="sr-only"> (PDF)</span>
          </a>
          <a
            class="text-link"
            href={site.socials[0].href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {about.githubLabel}
            <span aria-hidden="true">&#8599;</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>

      <ol class="rules" data-reveal-group>
        {about.rules.map((rule) => (
          <li class="rule-row" data-reveal-child>
            <span class="rule-key">{rule.key}</span>
            <div class="rule-copy">
              <h3>{rule.title}</h3>
              <p lang="id">{rule.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="about-foot">
      <div class="toolkit" data-reveal>
        <p class="small-label">Working with</p>
        <ul class="tags">
          {about.toolkit.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <dl class="facts" data-reveal>
        {about.facts.map((fact) => (
          <div class="fact">
            <dt>{fact.term}</dt>
            <dd lang="id">{fact.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--color-line);
    border-image: var(--grad-rule) 1;
  }

  .about-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: end;
    padding-bottom: clamp(44px, 6vw, 68px);
  }

  .about-lead {
    max-width: 46ch;
    color: var(--color-ink-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(34px, 5vw, 56px);
    padding-block: clamp(34px, 5vw, 52px);
    border-top: 1px solid var(--color-line-strong);
    border-image: var(--grad-rule-strong) 1;
  }

  .about-body {
    display: flex;
    max-width: 46ch;
    flex-direction: column;
    gap: 26px;
  }

  .about-body > p {
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-top: 2px;
  }

  .rules {
    position: relative;
    list-style: none;
  }

  .rules::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--grad-rule);
    pointer-events: none;
  }

  .rule-row {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 18px;
    padding-block: 20px;
    border-bottom: 1px solid var(--color-line);
    border-image: var(--grad-rule) 1;
    background-image: var(--row-wash);
  }

  .rule-key {
    padding-top: 5px;
    color: var(--color-copper);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .rule-copy h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    letter-spacing: -0.02em;
  }

  .rule-copy p {
    max-width: 48ch;
    margin-top: 7px;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .about-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding-top: clamp(30px, 4vw, 44px);
    border-top: 1px solid var(--color-line-strong);
    border-image: var(--grad-rule-strong) 1;
  }

  .toolkit .small-label {
    margin-bottom: 10px;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .fact {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--color-line);
  }

  .fact dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .fact dd {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .about-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(240px, 0.85fr);
      gap: 48px;
    }

    .about-lead {
      padding-bottom: 6px;
    }

    .about-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: clamp(40px, 6vw, 84px);
    }

    .about-foot {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.8fr);
      gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    }

    .rules {
      padding-left: clamp(28px, 4vw, 52px);
      border-left: 1px solid var(--color-line);
    }
  }
</style>