---
import { footer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a class="brand" href="#home" aria-label="Krishna, back to top">
        Krishna<span aria-hidden="true">.</span>
      </a>
      <p>{footer.tagline}</p>
    </div>

    <div class="footer-meta">
      <p>{footer.builtWith}</p>
      <p>Set in Newsreader and IBM Plex Sans.</p>
      <p>&copy; {year} Krishna.</p>
    </div>

    <a class="footer-top" href="#home">
      {footer.backToTop} <span aria-hidden="true">&#8593;</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    border-image: var(--grad-rule) 1;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding-block: 34px 40px;
  }

  .footer-brand .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
  }

  .brand span {
    color: var(--color-copper);
  }

  .footer-brand p {
    max-width: 34ch;
    margin-top: 8px;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .footer-top {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    justify-self: start;
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }

  .footer-top span {
    color: var(--color-copper);
    transition: transform 0.2s var(--ease-ledger);
  }

  .footer-top:hover span {
    transform: translateY(-3px);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr) auto;
      align-items: start;
      gap: 40px;
    }

    .footer-top {
      justify-self: end;
    }
  }
</style>