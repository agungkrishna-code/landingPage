---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Krishna"
  description="That page is not in the ledger. Return to Krishna's portfolio homepage."
>
  <main id="main" class="not-found" tabindex="-1">
    <div class="wrap not-found-inner">
      <p class="section-label">404</p>
      <h1>This page is not in the ledger.</h1>
      <p class="not-found-copy">
        The link is broken, or the page has moved. The work and the contact
        details are still on the homepage.
      </p>
      <a class="btn btn-primary" href="/">Back to the homepage</a>
      <a class="text-link" href="/#work">See the work</a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding-block: 64px;
  }

  .not-found-inner {
    max-width: 760px;
  }

  .not-found-inner .section-label {
    color: var(--color-copper);
  }

  .not-found h1 {
    max-width: 12ch;
    margin-top: 20px;
    font-size: clamp(2.7rem, 6vw, 5rem);
    line-height: 1;
  }

  .not-found-copy {
    max-width: 46ch;
    margin-top: 22px;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .not-found-inner .btn {
    margin-top: 30px;
    margin-right: 18px;
  }
</style>